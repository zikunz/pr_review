# =====================================================
# PR Cascade environment variables example
# =====================================================
# Copy this file to .env.local for local development.
# .env.local is gitignored.
# Production secrets go in Railway as service env vars.
# =====================================================

# GitHub App
# Numeric App ID from your GitHub App settings page.
GITHUB_APP_ID=

# Full PEM contents of the App private key. Newlines may be escaped as \n.
GITHUB_APP_PRIVATE_KEY=

# Webhook secret string configured when you registered the App.
# At least 32 random characters.
GITHUB_WEBHOOK_SECRET=

# GitHub App slug used for @mention detection in PR comments.
# Default matches the suggested App name.
GITHUB_BOT_USERNAME=pr-cascade-bot

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Application config
NODE_ENV=development
PORT=3000

# Hard cap on cost per single review, in US cents.
# A review that exceeds this is skipped and logged.
COST_CAP_CENTS_PER_REVIEW=30
