# =====================================================
# PR Cascade - environment variables example
# =====================================================
# Copy this file to .env.local for local dev.
# .env.local is in .gitignore.
# Production secrets go in Cloudflare via `wrangler secret put`.
# =====================================================

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./local-dev-only/github-app.private-key.pem
GITHUB_WEBHOOK_SECRET=

# LLM Providers
ANTHROPIC_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=

# Application config
NODE_ENV=development
LOG_LEVEL=debug
DAILY_BUDGET_CENTS=200
