# =====================================================
# PR Cascade environment variables example
# =====================================================
# Copy this file to .env.local for local development.
# .env.local is gitignored.
# Production secrets go in Railway as service env vars.
# =====================================================

# GitHub App
# Numeric App ID from your GitHub App settings page.
GITHUB_APP_ID=

# Full PEM contents of the App private key. Newlines may be escaped as \n.
GITHUB_APP_PRIVATE_KEY=

# Webhook secret string configured when you registered the App.
# At least 32 random characters.
GITHUB_WEBHOOK_SECRET=

# GitHub App slug used for @mention detection in PR comments. The default
# `pr-cascade-bot` is the slug the project owner registered, not a generic
# fallback. If you are deploying a fork, override this to the slug of the
# App you registered yourself, or @mention re-triggers will silently miss.
GITHUB_BOT_USERNAME=pr-cascade-bot

# OpenAI (or any OpenAI-compatible gateway)
# Leave OPENAI_BASE_URL unset to call OpenAI directly. To route through
# OpenRouter (one key for all providers, covered by the CS 153 promo), set:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_API_KEY=sk-or-...           (your OpenRouter key)
#   OPENAI_MODEL=openai/gpt-5.4-mini   (provider-prefixed name)
# OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Application config
NODE_ENV=development
PORT=3000

# Hard cap on cost per single review, in US cents.
# A review that exceeds this is skipped and logged.
COST_CAP_CENTS_PER_REVIEW=30

# Verification gate (v0.3, off by default)
# Set VERIFY_ENABLED=true to audit every diff-anchored finding with a second
# model before it is posted. A finding is dropped only when the verifier panel
# unanimously judges it a false positive. VERIFY_MODELS is a comma-separated
# list of slugs in the same form as OPENAI_MODEL (use the openai/ prefix when
# routing through OpenRouter). The default panel is a single model.
# VERIFY_ENABLED=false
# VERIFY_MODELS=gpt-5.5

# Agentic verification gate (v0.3, off by default)
# Set VERIFY_TOOLS_ENABLED=true to use a single tool-using verifier instead of
# the static panel above. It can read repository files at the PR head commit
# before deciding, rather than judging from the diff alone, and takes precedence
# over VERIFY_ENABLED when both are set. VERIFY_TOOLS_MAX_ITERS bounds the
# tool-calling turns per finding.
# VERIFY_TOOLS_ENABLED=false
# VERIFY_TOOLS_MODEL=gpt-5.5
# VERIFY_TOOLS_MAX_ITERS=8

# Cascade routing (v0.2, off by default)
# Set CASCADE_ENABLED=true to choose the review model from diff signals instead
# of always using OPENAI_MODEL. Tier 1 handles docs and media only, Tier 2
# handles code diffs at or under CASCADE_TIER2_MAX_CHARS, and Tier 3 handles
# larger code diffs. Each tier model must be in the pricing table. The defaults
# below match src/lib/cascade.ts.
# CASCADE_ENABLED=false
# CASCADE_TIER1_MODEL=openai/gpt-5.4-mini
# CASCADE_TIER2_MODEL=openai/gpt-5.4
# CASCADE_TIER3_MODEL=openai/gpt-5.5
# CASCADE_TIER2_MAX_CHARS=8000
