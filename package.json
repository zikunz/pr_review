{
  "name": "pr-cascade",
  "version": "0.1.1",
  "description": "Cost-aware GitHub PR review agent",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Zikun Zhu <zikun@stanford.edu>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zikunz/pr_review.git"
  },
  "bugs": {
    "url": "https://github.com/zikunz/pr_review/issues"
  },
  "homepage": "https://github.com/zikunz/pr_review#readme",
  "keywords": [
    "github-app",
    "pull-request",
    "code-review",
    "openai",
    "llm",
    "webhook",
    "hono",
    "typescript"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "verify": "npm run typecheck && npm run check && npm run test:run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "jose": "^6.2.3",
    "openai": "^6.49.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.9.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
