{
  "name": "pr-cascade",
  "version": "0.0.1",
  "description": "Cost-aware GitHub PR review agent",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "verify": "npm run typecheck && npm run check && npm run test:run"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "hono": "^4.12.19",
    "jose": "^6.2.3",
    "openai": "^6.38.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.8.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
